{
  "secret-guard": {
    "PreToolUse": [
      {
        "matcher": "read_file|write_file|edit_file|run_command|view_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/file-guard.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
